{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ch32-riscv-ug/ch32rv/docs/contract/events.schema.json",
  "title": "ch32rv NDJSON progress event (contract 5)",
  "description": "--progress ndjson 時に stderr へ 1 行 1 object。library の ProgressSink event と同一の型",
  "type": "object",
  "required": [
    "ev"
  ],
  "properties": {
    "ev": {
      "type": "string",
      "description": "event の種類。開いている: 今の値は phase、progress、retry、warn、log、output。足すことがあり、知らない ev の行は読み飛ばす"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ev": {
            "const": "phase"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "type": "string",
            "description": "erase / program / verify / reset / confirm-run 等"
          },
          "total": {
            "type": "integer",
            "description": "単位数が事前に分かる場合"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "progress"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "type": "string"
          },
          "done": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "phase",
          "done"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "retry"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "cause": {
            "type": "string",
            "description": "transport-timeout 等の安定名"
          }
        },
        "required": [
          "phase",
          "attempt",
          "cause"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "warn"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "type": "string"
          },
          "msg": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "msg"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "log"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info",
              "debug",
              "trace"
            ]
          },
          "msg": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "msg"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "output"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "type": "string",
            "description": "uart / sdi / dmdata / dmseq / rtt / semihosting"
          },
          "data": {
            "type": "string",
            "description": "target の実行時出力(UTF-8 文字境界で分割。--json 時の monitor / run)"
          }
        },
        "required": [
          "source",
          "data"
        ]
      }
    }
  ]
}
