{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ch32-riscv-ug/ch32rv/docs/contract/commands.schema.json",
  "title": "ch32rv command results (contract 5)",
  "description": "コマンドごとの result の形。$defs のコマンドの名前(封筒の cmd)の項がそのコマンドの result。field の追加は自由で、利用者は知らない field を無視する。result.schema.json がこの schema を参照する",
  "$defs": {
    "flash_result": {
      "type": "object",
      "description": "書き込みの結果。経路によらずこの形(docs/freeze-decisions.ja.md §7)。経路が持つものは足してある",
      "required": ["bytes", "family", "programmer", "verified", "running", "skipped", "scope"],
      "properties": {
        "bytes": {"type": "integer", "description": "書いた image の byte 数"},
        "family": {
          "type": ["string", "null"],
          "description": "target の family(例 CH32V30x)。経路が知らなければ null(hid、dfu)"
        },
        "programmer": {
          "type": "string",
          "description": "書いた経路。既知の値: stub(WCH-Link と flash stub)、controller(WCH-Link が FLASH controller を直接)、loader(WCH-Link と ch32rv の RAM loader)、oep-loader(OEP の probe と RAM loader)、hid(HID bootloader)、isp(factory ISP bootloader)、dfu(DFU 1.1)。値は足すことがある"
        },
        "verified": {
          "type": ["boolean", "null"],
          "description": "読み戻して一致した = true。検証しなかった = null。不一致はコマンドの失敗(exit 30)"
        },
        "running": {
          "type": ["boolean", "null"],
          "description": "書いた後に program が走っている = true、走っていない = false、分からない = null"
        },
        "skipped": {"type": "boolean", "description": "--preverify で一致したので消去も書き込みもしなかった"},
        "scope": {
          "type": "string",
          "description": "実際の消去の範囲(--erase の値): chip(code flash 全体)、sector(image が覆う page / sector だけ)、keep-store(STORE を残す。store を見る)、none(消さなかった。--erase none、または --preverify で一致して書かなかった)。値は足すことがある"
        },
        "store": {
          "type": "object",
          "description": "scope が keep-store のときだけ。STORE(ELF の .ch32rv_store)をどう残したか",
          "required": ["address", "bytes", "method"],
          "properties": {
            "address": {"type": ["string", "null"], "description": "STORE の先頭番地(0x 付きの hex)。image に STORE が無ければ null"},
            "bytes": {"type": "integer", "description": "STORE の byte 数(無ければ 0)"},
            "method": {
              "type": "string",
              "enum": ["untouched", "restored", "blank", "none-present"],
              "description": "untouched: どの消去も STORE に届かなかった。restored: chip erase の後で RAM loader で書き戻して照合した。blank: chip erase をしたが、STORE は前から消去済みの値だけだったので書き戻しは無い(中身は変わらない)。none-present: image に STORE が無い(sector と同じ動き)"
            }
          }
        },
        "seconds": {"type": "number", "description": "書き込みにかかった秒(経路が測るもの)"},
        "pages": {"type": "integer", "description": "loader: 書いた page 数"},
        "rewritten": {"type": "integer", "description": "loader: 書き直した page 数"},
        "restarted_runs": {"type": "integer", "description": "loader: 出し直した run の数"},
        "chip_id": {"type": ["string", "null"], "description": "target の chip id(経路が読むもの)"},
        "usb": {
          "type": ["string", "null"],
          "description": "bootloader の VID:PID(hid、isp。UART の isp では null)"
        },
        "sectors_written": {"type": "integer", "description": "hid: 変えた sector 数"},
        "sector_size": {"type": "integer", "description": "hid: sector の byte 数"},
        "erased_sectors": {
          "type": ["integer", "null"],
          "description": "isp: 消した 1 KiB sector の数(消さなければ null)"
        },
        "blocks": {"type": "integer", "description": "dfu: 送った block 数"},
        "transfer_size": {"type": "integer", "description": "dfu: 1 block の byte 数"}
      }
    },
    "verify_result": {
      "type": "object",
      "required": ["bytes", "verified"],
      "properties": {
        "bytes": {"type": "integer"},
        "verified": {"type": "boolean", "description": "一致した(不一致はコマンドの失敗、exit 30)"}
      }
    },
    "probe_firmware": {
      "type": "object",
      "properties": {
        "raw": {"type": "string", "description": "生 byte の hex"},
        "norm": {"type": "string", "description": "\"<major>.<minor>\"(0 埋めしない)。比較はこの値で"},
        "wch": {"type": "string", "description": "WCH の表示(v42 など)"},
        "known_bad": {"type": "boolean"},
        "mode": {"type": "string", "description": "riscv / arm(CH549 の Link だけ)"}
      }
    },
    "debug_wiring": {
      "type": ["object", "null"],
      "description": "デバッグの配線(DB にあれば)",
      "properties": {
        "wire": {"type": "string"},
        "swdio": {"type": ["string", "null"]},
        "swclk": {"type": ["string", "null"]}
      }
    },
    "isp_device": {
      "type": "object",
      "required": ["at", "chip_id", "device_type"],
      "properties": {
        "usb": {"type": ["string", "null"], "description": "VID:PID(UART なら null)"},
        "topology": {"type": ["string", "null"]},
        "at": {"type": "string", "description": "開いた場所(usb の位置か serial port)"},
        "series": {"type": ["string", "null"], "description": "family 名(知らない device_type なら null)"},
        "chip_id": {"type": "string", "description": "0x 付きの hex"},
        "device_type": {"type": "string", "description": "0x 付きの hex"},
        "btver": {"type": "string", "description": "bootloader の版"},
        "uid": {"type": "string", "description": "hex"},
        "read_protected": {"type": "boolean"},
        "config": {"type": "string", "description": "config の生 byte の hex"},
        "flash_bytes": {"type": ["integer", "null"]}
      }
    },
    "option_bytes": {
      "type": "object",
      "description": "target option get と isp config get の共通の形。options の key と value は option set / isp config set にそのまま渡せる",
      "required": ["family", "db_family", "raw", "read_protected", "write_protected", "options"],
      "properties": {
        "family": {"type": ["string", "null"], "description": "target: session の family。isp: bootloader の series(知らなければ null)"},
        "db_family": {"type": ["string", "null"], "description": "option の配置を引いた DB の family"},
        "raw": {"type": "string", "description": "読んだ byte の hex。target は補数込みの 16 byte、isp は bootloader の config 12 byte"},
        "read_protected": {"type": "boolean"},
        "write_protected": {"type": "boolean", "description": "WRPR に 0 の bit がある"},
        "options": {
          "type": "object",
          "description": "key ごとに値の語(value)と生の値(raw)。USER の意味名(iwdg / stop-reset / standby-reset / reset-pin / start-mode / can-bus-off / ram-split / reset-pin-select / over-voltage / usbfs-download / usbhs-download / usart-download。device DB の option_byte_fields の option 列)は family が持つものだけ、option の無い USER の field は user.<RM の名前>",
          "required": ["read-protect", "write-protect", "data0", "data1"],
          "properties": {
            "read-protect": {"$ref": "#/$defs/option_value"},
            "write-protect": {"$ref": "#/$defs/option_value"},
            "data0": {"$ref": "#/$defs/option_value"},
            "data1": {"$ref": "#/$defs/option_value"},
            "iwdg": {"$ref": "#/$defs/option_value"},
            "stop-reset": {"$ref": "#/$defs/option_value"},
            "standby-reset": {"$ref": "#/$defs/option_value"},
            "reset-pin": {"$ref": "#/$defs/option_value"}
          },
          "additionalProperties": {"$ref": "#/$defs/option_value"}
        }
      }
    },
    "option_value": {
      "type": "object",
      "required": ["value", "raw"],
      "properties": {
        "value": {"type": "string", "description": "set に渡す値の語(on / off / sw / 12ms / 0x5a など)"},
        "raw": {"type": "integer", "minimum": 0, "description": "field の生の値(bit の値、byte、WRPR の 32 bit。write-protect の value は EVT の向き(立った bit = 保護)で、raw の WRPR はその反転)"}
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "git_rev", "target_db", "flash_stub_digest", "build"],
      "properties": {
        "version": {"type": "string", "description": "ch32rv の版"},
        "git_rev": {"type": "string"},
        "target_db": {
          "type": "object",
          "properties": {
            "source": {"type": "string"},
            "source_rev": {"type": ["string", "null"]},
            "digest": {"type": "string"}
          }
        },
        "flash_stub_digest": {"type": "string"},
        "build": {
          "type": "object",
          "properties": {"os": {"type": "string"}, "arch": {"type": "string"}}
        }
      }
    },
    "flash": {
      "type": "object",
      "required": ["flash"],
      "properties": {"flash": {"$ref": "#/$defs/flash_result"}}
    },
    "isp.flash": {
      "type": "object",
      "required": ["flash"],
      "properties": {
        "flash": {"$ref": "#/$defs/flash_result"},
        "device": {"$ref": "#/$defs/isp_device"}
      }
    },
    "boot.dfu.flash": {
      "type": "object",
      "required": ["flash"],
      "properties": {"flash": {"$ref": "#/$defs/flash_result"}}
    },
    "boot.hid.flash": {
      "type": "object",
      "required": ["flash"],
      "properties": {"flash": {"$ref": "#/$defs/flash_result"}}
    },
    "verify": {"$ref": "#/$defs/verify_result"},
    "isp.verify": {"$ref": "#/$defs/verify_result"},
    "read": {
      "type": "object",
      "required": ["addr", "len"],
      "properties": {
        "addr": {"type": "string", "description": "先頭番地"},
        "len": {"type": "integer", "description": "byte 数"},
        "out": {"type": "string", "description": "--out: 書いたファイル"},
        "hex": {"type": "string", "description": "--out 無し: 読んだ byte の hex"},
        "blank": {"type": "boolean", "description": "--blank: すべて消去済みの値か"}
      }
    },
    "write": {
      "type": "object",
      "required": ["addr", "len", "region"],
      "properties": {
        "addr": {"type": "string", "description": "0x 付きの hex"},
        "len": {"type": "integer"},
        "region": {"type": "string", "description": "flash / memory"},
        "verified": {"type": ["boolean", "null"], "description": "読み戻して一致 = true、検証しなかった = null"}
      }
    },
    "erase": {
      "type": "object",
      "required": ["scope", "family"],
      "properties": {
        "scope": {"type": "string", "description": "chip / sector / range"},
        "family": {"type": "string"},
        "addr": {"type": "string", "description": "0x 付きの hex"},
        "len": {"type": "integer"},
        "pages": {"type": "integer"},
        "page_size": {"type": "integer"}
      }
    },
    "reset": {
      "type": "object",
      "required": ["mode", "running"],
      "properties": {
        "mode": {"type": "string", "description": "run / halt"},
        "running": {"type": ["boolean", "null"], "description": "走っている(halt なら false)。分からなければ null"},
        "pc": {"type": "string", "description": "OEP: reset 後の pc"}
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "exit": {"type": "integer", "description": "target の終了コード(semihosting の exit)"},
        "reason": {"type": "string", "description": "timeout: --exit-on timeout で --duration に達した"},
        "dpc": {"type": "string", "description": "止まった所(target-halted)"}
      }
    },
    "recover": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "description": "nrst / unprotect / unbrick / power-off / special-erase など。無ければ診断だけ(state)"
        },
        "family": {"type": ["string", "null"]},
        "state": {"type": "string", "description": "診断: target の状態"},
        "probe": {"type": "string"},
        "speed": {"type": ["string", "null"]},
        "db_family": {"type": ["string", "null"]},
        "chip_id": {"type": ["string", "null"], "description": "0x 付きの hex(分からなければ null)"},
        "option_bytes": {"type": ["string", "null"]},
        "recommendation": {
          "type": "object",
          "properties": {"action": {"type": "string"}, "command": {"type": ["string", "null"]}}
        },
        "notes": {"type": "array", "items": {"type": "string"}},
        "caveats": {"type": "array", "items": {"type": "string"}},
        "stopped_at": {"type": ["string", "null"], "description": "0x 付きの hex(分からなければ null)"},
        "unprotected": {"type": "boolean"},
        "erased": {"type": "boolean"},
        "image": {"type": ["integer", "null"]},
        "preserved_user_bits": {"type": "boolean"},
        "note": {"type": "string"},
        "protected": {"type": "boolean"},
        "action": {"type": "string"},
        "attempts": {"type": "integer"},
        "answers": {"type": "array", "items": {"type": "string"}},
        "confirmed": {"type": "boolean"}
      }
    },
    "probe.list": {
      "type": "object",
      "required": ["probes"],
      "properties": {
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "serial", "usb", "ports"],
            "properties": {
              "kind": {"type": "string", "enum": ["wchlink", "oep"]},
              "serial": {"type": "string", "description": "USB の serial。OEP の probe では unit_id と同じ"},
              "usb": {"type": "string", "description": "VID:PID"},
              "topology": {"type": "string", "description": "<bus>-<ports>"},
              "ports": {"type": "array", "items": {"type": "string"}},
              "model": {"type": "string", "description": "表示用の名前(照合には使わない)"},
              "tcp": {
                "type": "string",
                "description": "OEP だけ。同じ probe が DNS-SD(_oep._tcp)でも見つかったときの <address>:<port>"
              },
              "variant": {"type": "string", "description": "WCH-Link だけ。probe.variant と同じ"},
              "address": {"type": "string", "description": "--probe に渡せる住所"},
              "mode": {"type": "string", "enum": ["riscv", "dap", "iap", "isp", "unknown"]},
              "firmware": {
                "type": ["object", "string", "null"],
                "properties": {
                  "raw": {"type": "string", "description": "生 byte の hex"},
                  "norm": {"type": "string", "description": "\"<major>.<minor>\"(0 埋めしない)。比較はこの値で"},
                  "wch": {"type": "string", "description": "WCH の表示(v42 など)"},
                  "known_bad": {"type": "boolean"},
                  "mode": {"type": "string", "description": "riscv / arm(CH549 の Link だけ)"}
                },
                "description": "WCH-Link は object。OEP の probe は describe の FIRMWARE の文字列。読めなかったとき(CDC の port がまだ無い、答えない)は null"
              }
            }
          },
          "description": "つながっている probe。WCH-Link と USB の OEP probe"
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "unit_id", "tcp"],
            "properties": {
              "kind": {"type": "string", "enum": ["oep"]},
              "address": {"type": "string", "description": "oep://<unit_id>"},
              "firmware": {"type": ["string", "null"]},
              "unit_id": {"type": "string", "description": "TXT の unit_id"},
              "tcp": {"type": "string", "description": "<address>:<port>"},
              "instance": {"type": "string", "description": "DNS-SD の instance の名前(表示用)"}
            }
          },
          "description": "USB に無く、ローカルネットワークで DNS-SD(_oep._tcp)に名乗った OEP probe。名乗った unit_id に confirm と describe で答えたものだけ(答えないものは警告 oep-tcp-unverified で除く)"
        }
      }
    },
    "probe.info": {
      "type": "object",
      "description": "WCH-Link は封筒の probe に出し、result は無い。OEP の probe は result.probe",
      "properties": {
        "probe": {
          "type": "object",
          "properties": {
            "kind": {"type": "string"},
            "firmware": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "unit_id": {"type": ["string", "null"]},
            "chip": {"type": ["string", "null"]},
            "max_op_ms": {"type": ["integer", "null"]},
            "interfaces": {"type": "array", "items": {"type": "object", "properties": {}}},
            "ports": {"type": "array", "items": {"type": "string"}},
            "labels": {"type": "array", "items": {"type": "object", "properties": {}}}
          }
        }
      }
    },
    "probe.power": {
      "type": "object",
      "required": ["rail", "on"],
      "properties": {
        "rail": {"type": "string", "description": "3v3 / 5v"},
        "on": {"type": "boolean"},
        "cycled": {"type": "boolean"},
        "off_ms": {"type": "integer"}
      }
    },
    "probe.mode.get": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string"},
        "vid": {"type": "string", "description": "0x 付きの hex"},
        "pid": {"type": "string", "description": "0x 付きの hex"},
        "firmware_mode": {"type": ["string", "null"]}
      }
    },
    "probe.mode.set": {
      "type": "object",
      "required": ["mode", "changed"],
      "properties": {
        "mode": {"type": "string"},
        "changed": {"type": "boolean"},
        "reenumerating": {"type": "boolean"}
      }
    },
    "probe.firmware.info": {
      "type": "object",
      "required": ["firmware", "variant", "known_bad"],
      "properties": {
        "firmware": {"type": "string", "description": "\"<major>.<minor>\"(0 埋めしない)"},
        "variant": {"type": "string"},
        "raw": {"type": "string"},
        "wch": {"type": "string"},
        "firmware_mode": {"type": ["string", "null"]},
        "known_bad": {"type": "boolean"},
        "known_bad_reason": {"type": ["string", "null"]}
      }
    },
    "probe.firmware.check": {
      "type": "object",
      "required": ["firmware"],
      "properties": {
        "firmware": {"type": "string", "description": "\"<major>.<minor>\"(0 埋めしない)"},
        "min": {"type": ["string", "null"], "description": "--min"}
      }
    },
    "probe.firmware.exit-iap": {
      "type": "object",
      "required": ["left_iap"],
      "properties": {"firmware": {"type": ["string", "null"]}, "left_iap": {"type": "boolean"}}
    },
    "probe.firmware.update": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "dry_run": {"type": "boolean"},
        "image": {
          "type": "object",
          "properties": {
            "path": {"type": "string"},
            "bytes": {"type": "integer"},
            "version": {"type": ["string", "null"]},
            "usb_ids": {"type": "array", "items": {"type": "string"}},
            "riscv": {"type": "boolean"},
            "sha256": {"type": "string"},
            "known": {
              "type": ["object", "null"],
              "properties": {
                "device": {"type": "string"},
                "mcu": {"type": "string"},
                "mode": {"type": ["string", "null"]},
                "role": {"enum": ["application", "with-bootloader"], "description": "application = FIRMWARE_*.bin(application だけ。IAP 経路で書くのはこれ)、with-bootloader = *APP_IAP*.bin(IAP bootloader の後に application。外部書込機用で、update は拒否する)"},
                "file": {"type": "string"},
                "version": {"type": "string"}
              }
            }
          }
        },
        "frames_per_pass": {"type": "integer"},
        "firmware_before": {"type": ["string", "null"]},
        "firmware_after": {"type": ["string", "null"]}
      }
    },
    "target.info": {
      "type": "object",
      "description": "識別の本体は封筒の target。ここはその詳しい所",
      "properties": {
        "connection": {"type": "string"},
        "identification": {"type": "string", "description": "identified / ambiguous / …"},
        "family_byte": {"type": "string", "description": "0x 付きの hex"},
        "silicon_revision": {"type": "integer"},
        "sram_bytes": {"type": ["integer", "null"]},
        "sku_candidates": {"type": "array", "items": {"type": "string"}},
        "flash_capacity_source": {"type": ["string", "null"]},
        "flash_capacity_raw": {
          "type": ["string", "null"],
          "description": "0x 付きの hex(分からなければ null)"
        },
        "protection_raw": {"type": ["string", "null"]},
        "chip_id_echo": {"type": ["string", "null"], "description": "0x 付きの hex(分からなければ null)"},
        "debug_wiring": {"$ref": "#/$defs/debug_wiring"},
        "probe": {
          "type": "object",
          "description": "OEP: probe の種類",
          "properties": {"kind": {"type": "string"}}
        },
        "target": {
          "type": "object",
          "description": "OEP: 識別した target(封筒の target と同じ値)",
          "properties": {
            "chip_id": {"type": ["string", "null"], "description": "0x 付きの hex(分からなければ null)"},
            "family": {"type": ["string", "null"]},
            "sku": {"type": ["string", "null"]},
            "uid": {"type": ["string", "null"]},
            "flash_bytes": {"type": ["integer", "null"]},
            "sram_bytes": {"type": ["integer", "null"]}
          }
        }
      }
    },
    "target.list": {
      "type": "object",
      "required": ["places"],
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "mode"],
            "properties": {
              "address": {"type": "string", "description": "住所。debug probe(mode が app / isp / hid 以外)は --probe に、書き込み先(app、isp、hid)は isp / boot dfu / boot hid の --device に渡す"},
              "mode": {"type": "string"},
              "topology": {"type": "string"},
              "model": {"type": "string"},
              "label": {"type": ["string", "null"]},
              "properties": {"type": "object", "properties": {}},
              "target": {
                "type": "object",
                "description": "--identify: target info の target(読めなければ error)",
                "properties": {}
              },
              "runs_on": {
                "type": ["string", "null"],
                "description": "アプリの行: それが動くチップのデバッグの場所の address"
              }
            }
          }
        }
      }
    },
