{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ch32-riscv-ug/ch32rv/docs/contract/result.schema.json",
  "title": "ch32rv result envelope (contract 1)",
  "type": "object",
  "required": ["contract", "ok", "cmd"],
  "properties": {
    "contract": {
      "type": "string",
      "description": "契約版。破壊変更でのみ major を上げる",
      "const": "1"
    },
    "ok": { "type": "boolean" },
    "cmd": {
      "type": "string",
      "description": "実行された command の正規名 (例: \"flash\", \"probe.firmware.check\")"
    },
    "probe": {
      "type": "object",
      "description": "操作に使った probe。probe を開く前に失敗した場合は無い",
      "properties": {
        "model": { "type": "string", "description": "例: WCH-LinkE / WCH-Link(CH549)" },
        "serial": { "type": "string" },
        "usb": { "type": "string", "description": "VID:PID" },
        "topology": { "type": "string", "description": "bus-port 形式。serial の無い device の選択子" },
        "mode": { "type": "string", "enum": ["riscv", "dap", "iap", "isp", "unknown"] },
        "firmware": {
          "type": "object",
          "properties": {
            "raw": { "type": "string", "description": "生 byte の hex" },
            "norm": { "type": "string", "description": "正規化表記 (2.12)。比較はこの値で行う" },
            "wch": { "type": "string", "description": "WCH 表示 (v32)" },
            "known_bad": { "type": "boolean" },
            "mode": { "type": "string", "description": "firmware mode (riscv|arm)。RV/ARM別firmwareはCH549のみ" }
          }
        },
        "ports": {
          "type": "array",
          "description": "この probe に属する serial port ノード (UART bridge / SDI)。例 /dev/ttyACM5",
          "items": { "type": "string" }
        }
      }
    },
    "target": {
      "type": "object",
      "description": "識別された target。attach 前に失敗した場合は無い",
      "properties": {
        "sku": { "type": "string" },
        "family": { "type": "string" },
        "chip_id": { "type": "string", "description": "0x 付き hex" },
        "uid": { "type": "string" },
        "verified": { "type": "boolean", "description": "DB 上で実機確認済みの SKU か" },
        "provisional": { "type": "boolean", "description": "暫定 overlay 由来の DB entry か" },
        "protected": { "type": "boolean" },
        "flash_kb": { "type": "integer", "description": "probe が報告する flash 容量 (KiB)" }
      }
    },
    "result": {
      "description": "command 固有の結果。per-command schema は別途追加する",
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "msg"],
        "properties": {
          "code": { "type": "string", "description": "安定した警告 code (例: fw-known-bad, target-unverified)" },
          "msg": { "type": "string" }
        }
      }
    },
    "error": {
      "type": "object",
      "description": "ok=false のとき必須",
      "required": ["code", "kind", "msg"],
      "properties": {
        "code": {
          "type": "integer",
          "description": "exit code と同値 (cli.ja.md §3.6)",
          "enum": [2, 10, 11, 12, 13, 14, 20, 21, 22, 23, 24, 30, 40, 41, 50, 70]
        },
        "kind": { "type": "string", "description": "安定した機械可読名 (例: probe-not-found, target-ambiguous)" },
        "msg": { "type": "string" },
        "hint": { "type": "string", "description": "次の一手 (人間向け)" },
        "candidates": {
          "type": "array",
          "description": "曖昧エラー (14/23) のときの候補一覧",
          "items": { "type": "object" }
        },
        "capability": {
          "type": "object",
          "description": "code=24 のときの不可理由 (probe×fw×target×operation)"
        }
      }
    }
  },
  "if": { "properties": { "ok": { "const": false } } },
  "then": { "required": ["error"] }
}
